# Copy to .env and adjust. All values are optional; these are the defaults.

# Upstream endpoint returning a JSON list of country records
COUNTRIES_API_URL=https://restcountries.com/v3.1/all?fields=name,cca2,cca3,capital,region,subregion,population,area,languages,currencies

# Seconds to keep fetched data in memory before refetching
CACHE_TTL_SECONDS=3600

# Upstream HTTP timeout in seconds
REQUEST_TIMEOUT=10

# Set to true to skip the network and serve the bundled sample data
USE_SAMPLE_DATA_ONLY=false
